# ================================================================
# Digital World Tour & Travels - Backend Environment Variables
# ================================================================

# Security & App
SECRET_KEY=django-insecure-your-secret-key-goes-here-change-in-production
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1,0.0.0.0

# PostgreSQL Database Configuration
DB_ENGINE=django.db.backends.postgresql
DB_NAME=digital_world_travels
DB_USER=your_db_user
DB_PASSWORD=your_secure_db_password
DB_HOST=localhost
DB_PORT=5432
DB_CONN_MAX_AGE=600

# CORS Configuration for Frontend
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# JWT Configuration (Optional overrides)
JWT_ACCESS_TOKEN_LIFETIME_MINUTES=60
JWT_REFRESH_TOKEN_LIFETIME_DAYS=7

# ================================================================
# Flight API Provider Configuration (Travelport / Amadeus / Mock)
# ================================================================
FLIGHT_API_PROVIDER=travelport

# Travelport+ Pre-Production Credentials
TRAVELPORT_USERNAME=your_travelport_username
TRAVELPORT_PASSWORD=your_travelport_password
TRAVELPORT_CLIENT_ID=your_travelport_client_id
TRAVELPORT_CLIENT_SECRET=your_travelport_client_secret
TRAVELPORT_ACCESSGROUP=your_access_group
TRAVELPORT_PCC=P1234567
TRAVELPORT_ENVIRONMENT=preproduction
TRAVELPORT_OAUTH_URL=https://auth.pp.travelport.net/oauth/token
TRAVELPORT_API_BASE_URL=https://api.pp.travelport.net/11/air/
AMADEUS_CLIENT_ID=your_amadeus_api_key
AMADEUS_CLIENT_SECRET=your_amadeus_api_secret
AMADEUS_ENVIRONMENT=test
DUFFEL_API_TOKEN=your_duffel_token
FLIGHT_BASE_CURRENCY=NPR
FLIGHT_AGENCY_MARKUP_PERCENT=5.0
FLIGHT_PRICE_LOCK_MINUTES=15


